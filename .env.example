PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/library_reservation
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Library rules (optional)
PICKUP_DAYS=3
LOAN_DAYS=14
FINE_PER_DAY=5

# Email (optional). Leave SMTP_HOST empty and emails are printed in the server console instead.
# Gmail example: host smtp.gmail.com, port 587, user = your address, pass = an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SIT Library <library@example.com>"
